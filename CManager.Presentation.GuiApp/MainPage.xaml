<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CManager.Presentation.GuiApp"
             x:Class="CManager.Presentation.GuiApp.MainPage">

    <ContentPage.Resources>
        <local:ViewModelToViewConverter x:Key="VmToView" />
    </ContentPage.Resources>

    <Grid>
        <ContentView Content="{Binding CurrentViewModel, Converter={StaticResource VmToView}}" />
    </Grid>

</ContentPage>