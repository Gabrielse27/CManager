<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CManager.Presentation.GuiApp.ViewModels"
             xmlns:model="clr-namespace:CManager.Domain;assembly=CManager.Domain"
             x:Class="CManager.Presentation.GuiApp.Views.CustomersPage"
             x:DataType="vm:CustomersPageViewModel">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="10">

        <HorizontalStackLayout Grid.Row="0" Spacing="20">
            <Label Text="Kundlista" 
                   FontSize="24" 
                   VerticalOptions="Center" 
                   FontAttributes="Bold"/>

            <Button Text="Add Customer" 
                    Command="{Binding GoToCreateCustomerPageCommand}"
                    BackgroundColor="DodgerBlue"
                    TextColor="White"/>
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Customers}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Customer">
                    <Frame Margin="0,5" Padding="15" BorderColor="LightGray" CornerRadius="5">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomersPageViewModel}}, Path=GoToDetailsCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="*, Auto">

                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding FirstName}" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="{Binding LastName}" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="{Binding Email}" TextColor="Gray" FontSize="12"/>
                                <Label Text="{Binding Phone}" TextColor="Gray" FontSize="12"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="🗑" 
                                    BackgroundColor="Red"
                                    TextColor="Red"
                                    FontSize="20"
                                    VerticalOptions="Center"
                                    ZIndex="10"
                                    Clicked="OnDeleteClicked"
                                    CommandParameter="{Binding .}" />

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>